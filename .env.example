# Public HTTPS URL of the MCP server (the MCP endpoint is $PUBLIC_URL/mcp)
PUBLIC_URL=https://paperless-mcp.example.com

# Generate with: openssl rand -base64 48
SECRET_KEY=

# Optional: preconfigured Paperless instance (users sign in with username + password)
PAPERLESS_URL=

# Optional: restrict which Paperless hosts users may connect to (only without PAPERLESS_URL)
PAPERLESS_ALLOWED_HOSTS=
