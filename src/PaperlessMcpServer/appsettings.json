{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning",
      "ModelContextProtocol": "Warning",
      "PaperlessMcpServer.Auth.SealedTokenAuthenticationHandler": "Warning",
      "ModelContextProtocol.AspNetCore.Authentication": "Warning"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "SingleLine": true,
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss "
      }
    }
  },
  "AllowedHosts": "*"
}
